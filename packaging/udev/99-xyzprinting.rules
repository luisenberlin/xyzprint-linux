# SPDX-License-Identifier: MIT
#
# XYZprinting da Vinci 1.0 Pro — interfaz USB CDC-ACM (11F1:2520).
#
# La impresora expone una interfaz CDC (clase 02/02/01) que el kernel maneja
# con cdc_acm; no hace falta driver propietario. Esta regla da acceso al
# usuario de la sesión sin ejecutar la app como root.
#
# Instalación:
#   sudo install -m 0644 99-xyzprinting.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# `uaccess` concede un ACL al usuario con sesión local (systemd-logind);
# `MODE="0666"` cubre sesiones sin logind y equipos de un solo usuario.
# Si prefieres restringirlo, usa MODE="0660" y GROUP="dialout" (Debian/Ubuntu)
# o GROUP="uucp" (Arch).

# da Vinci 1.0 Pro (VID_11F1&PID_2520)
SUBSYSTEM=="tty", ATTRS{idVendor}=="11f1", ATTRS{idProduct}=="2520", \
    MODE="0666", TAG+="uaccess"

# Nota: la actualización de firmware por USB directo (libusb) necesitaría una
# regla sobre SUBSYSTEM=="usb" para el mismo VID/PID. No se incluye porque el
# port usa solo la interfaz CDC y no queremos abrir el dispositivo USB crudo.
